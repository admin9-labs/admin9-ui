{
  "name": "@admin9-labs/admin9-ui",
  "version": "0.6.0",
  "description": "补充 Arco Design Vue 中后台通用场景的 Vue 组件库",
  "type": "module",
  "license": "MIT",
  "author": "Admin9 Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/admin9-labs/admin9-ui.git"
  },
  "homepage": "https://github.com/admin9-labs/admin9-ui#readme",
  "bugs": {
    "url": "https://github.com/admin9-labs/admin9-ui/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/style.css",
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js",
      "require": "./dist/locale/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "locale": [
        "dist/locale/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "docs/components",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.less",
    "**/*.css",
    "*.vue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build --config vite.config.lib.ts",
    "dev": "vite build --watch --config vite.config.lib.ts",
    "acceptance:dev": "vite --config vite.config.dev.ts",
    "acceptance:typecheck": "vue-tsc --noEmit -p dev/tsconfig.json",
    "acceptance:build": "vite build --config vite.config.dev.ts",
    "type:check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "pnpm run lint:eslint && pnpm run lint:style",
    "lint:eslint": "eslint \"./src/**/*.{js,jsx,ts,tsx,vue}\" \"./tests/**/*.{js,jsx,ts,tsx}\" \"./dev/**/*.{js,jsx,ts,tsx,vue}\" \"./scripts/**/*.mjs\" \"./vite.config.*.ts\"",
    "lint:style": "stylelint \"./src/**/*.{css,less,vue}\" \"./dev/**/*.{css,less,vue}\"",
    "changelog:check": "node scripts/check-changelog.mjs --check",
    "verify:tarball": "node scripts/verify-tarball.mjs",
    "release:check": "pnpm run changelog:check && pnpm run type:check && pnpm run acceptance:typecheck && pnpm run lint && pnpm test && pnpm run acceptance:build && pnpm run verify:tarball"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@arco-design/web-vue": "^2.57.0",
    "vue-i18n": "^9.14.0"
  },
  "devDependencies": {
    "@arco-design/web-vue": "2.57.0",
    "@vitejs/plugin-vue": "3.2.0",
    "@vitejs/plugin-vue-jsx": "2.1.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "20.8.9",
    "less": "4.4.0",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "prettier": "^2.8.8",
    "stylelint": "^16.26.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "^6.0.4",
    "typescript": "4.9.5",
    "vite": "3.2.11",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "0.34.6",
    "vue": "3.5.18",
    "vue-eslint-parser": "^9.4.3",
    "vue-i18n": "9.14.5",
    "vue-tsc": "1.8.27"
  },
  "dependencies": {
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-bubble-menu": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@tiptap/vue-3": "^3.29.2"
  }
}
