{
  "name": "@admin9-labs/admin9-ui",
  "version": "0.1.0",
  "description": "补充 Arco Design Vue 中后台通用场景的 Vue 组件库",
  "type": "module",
  "license": "MIT",
  "author": "Admin9 Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/admin9-labs/admin9-ui.git"
  },
  "homepage": "https://github.com/admin9-labs/admin9-ui#readme",
  "bugs": {
    "url": "https://github.com/admin9-labs/admin9-ui/issues"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/style.css",
    "./locale": {
      "types": "./dist/locale/index.d.ts",
      "import": "./dist/locale/index.js",
      "require": "./dist/locale/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.less",
    "**/*.css",
    "*.vue"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build --config vite.config.lib.ts",
    "dev": "vite build --watch --config vite.config.lib.ts",
    "type:check": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "npm run lint:eslint && npm run lint:style",
    "lint:eslint": "eslint \"./src/**/*.{js,jsx,ts,tsx,vue}\" \"./tests/**/*.{js,jsx,ts,tsx}\"",
    "lint:style": "stylelint \"./src/**/*.{css,less,vue}\""
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@arco-design/web-vue": "^2.57.0",
    "vue-i18n": "^9.14.0"
  },
  "devDependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitejs/plugin-vue-jsx": "4.2.0",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.10.2",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.5",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "20.8.9",
    "less": "^4.5.1",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "prettier": "^2.8.8",
    "stylelint": "^16.26.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^5.4.0",
    "vite": "6.4.3",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "3.2.6",
    "vue": "^3.5.0",
    "vue-eslint-parser": "^9.4.3",
    "vue-i18n": "^9.14.0",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.16.0"
}
