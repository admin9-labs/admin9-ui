{
  "name": "@admin9-labs/admin9-ui",
  "version": "0.1.0",
  "description": "Admin9 Pro 中后台增强业务组件库，基于 Arco Design Vue",
  "type": "module",
  "license": "MIT",
  "author": "Admin9 Team",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/style.css",
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    }
  },
  "files": ["dist"],
  "sideEffects": ["**/*.less", "**/*.css", "*.vue"],
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build --config vite.config.lib.ts",
    "dev": "vite build --watch --config vite.config.lib.ts",
    "type:check": "vue-tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@arco-design/web-vue": "^2.57.0",
    "vue-i18n": "^9.14.0",
    "@vueuse/core": "^9.13.0"
  },
  "devDependencies": {
    "@arco-design/web-vue": "^2.57.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitejs/plugin-vue-jsx": "4.2.0",
    "@vueuse/core": "^9.13.0",
    "less": "^4.5.1",
    "typescript": "^5.4.0",
    "vite": "6.4.3",
    "vite-plugin-dts": "^3.9.0",
    "vue": "^3.5.0",
    "vue-i18n": "^9.14.0",
    "vue-tsc": "^2.0.0"
  }
}
